# Скопируй в .env и поменяй секреты (в git .env не попадает)
POSTGRES_PASSWORD=compass_demo
# Секреты: длина от 32 байт (RFC 7518 для HS256; PyJWT ругается на короткие)
JWT_SECRET=dev_jwt_secret_change_me_min_32_bytes!
PII_PEPPER=dev_pepper_change_me
# Куда ведёт QR-приглашение пациента (PWA-экран привязки)
PATIENT_APP_URL=http://127.0.0.1:5500/bind
# Демо-пароль врачей из backend/db/seed.py: compass-demo-2026
# OWNER_DATABASE_URL=postgresql://compass_app:compass_demo@localhost:5433/compass
# APP_DATABASE_URL=postgresql://compass_api:compass_api_demo@localhost:5433/compass
# TG_BOT_TOKEN=
