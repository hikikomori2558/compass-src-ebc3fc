{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. Собрать C-Core (libcompass_core.so)",
            "type": "shell",
            "command": "python3 scripts/build_c_core.py",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "2. Синхронизироваться с GitHub (git pull --rebase)",
            "type": "shell",
            "command": "git pull --rebase origin main",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "3. Смоук C-Core (бенчмарк отклика, Метрика №1)",
            "type": "shell",
            "command": "python3 -m tests.test_c_core_smoke",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "4. Тест 3 эталонных сценариев (safe pipeline)",
            "type": "shell",
            "command": "python3 -m backend.services.pipeline",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "5. Бенчмарк 100 синтетических ЭМК (протокол апробации)",
            "type": "shell",
            "command": "python3 -m benchmarks.ehr_nlp_benchmark",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "6. Научные графики -> benchmarks/plots/",
            "type": "shell",
            "command": "python3 -m benchmarks.generate_scientific_plots",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "7. Запустить bio API сервер (Swagger :8000)",
            "type": "shell",
            "command": "python3 -m backend.api.bio",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "8. Поднять инфраструктуру (docker: db+redis+api)",
            "type": "shell",
            "command": "docker compose up -d --build",
            "problemMatcher": []
        },
        {
            "label": "9. Seed БД (демо-данные)",
            "type": "shell",
            "command": "python3 -m backend.db.seed",
            "problemMatcher": []
        },
        {
            "label": "10. RLS-тест изоляции данных",
            "type": "shell",
            "command": "python3 -m tests.test_db_rls",
            "problemMatcher": []
        },
        {
            "label": "11. Тест pii_scrubber (152-ФЗ)",
            "type": "shell",
            "command": "python3 -m tests.test_c_pii_scrubber",
            "problemMatcher": []
        },
        {
            "label": "12. Тест аутентификации и QR-привязки",
            "type": "shell",
            "command": "python3 -m tests.test_api_auth",
            "problemMatcher": []
        },
        {
            "label": "13. Тест WS-шины алертов (<50 мс, пустой пинг)",
            "type": "shell",
            "command": "python3 -m tests.test_api_alerts_ws",
            "problemMatcher": []
        },
        {
            "label": "14. Тест лексера ЭМК (Ахо—Корасик vs наивный)",
            "type": "shell",
            "command": "python3 -m tests.test_c_lexer_ahocorasik",
            "problemMatcher": []
        }
    ]
}
